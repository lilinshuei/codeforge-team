{
  "schema": "codeforge.agent-team/v1",
  "id": "codeforge-team",
  "version": "1.0.0",
  "name": {
    "en": "CodeForge Expert Team",
    "zh": "代码工坊专家团"
  },
  "description": {
    "en": "40 specialists in 4 groups cover product planning, engineering, quality & security, and experience delivery, taking an idea from requirement to a shippable, reviewed and deployed product.",
    "zh": "40位专家分四组协作，覆盖产品规划、工程实现、质量安全与体验交付，从需求到上线交付可运行软件。"
  },
  "author": {
    "name": "lilinshuei",
    "url": "https://github.com/lilinshuei"
  },
  "license": "MIT",
  "lead": "codeforge-team-lead",
  "groups": [
    {
      "id": "product-planning",
      "zh": "产品规划组",
      "en": "Product Planning",
      "lead": "product-planning-lead",
      "mission": "把模糊想法变成可验收的产品方案：需求、产品、研究、交互、视觉、市场、数据、商业化与敏捷节奏。",
      "members": [
        "requirement-analyst",
        "product-manager",
        "ux-researcher",
        "interaction-designer",
        "visual-designer",
        "market-researcher",
        "product-analyst",
        "monetization-strategist",
        "agile-coach"
      ]
    },
    {
      "id": "engineering",
      "zh": "工程实现组",
      "en": "Engineering",
      "lead": "engineering-lead",
      "mission": "把方案落成可运行系统：架构、前端、后端、全栈、数据库、API、跨端、建站与 DevOps。",
      "members": [
        "solution-architect",
        "frontend-engineer",
        "backend-engineer",
        "fullstack-prototyper",
        "database-engineer",
        "api-integrator",
        "crossplatform-engineer",
        "website-builder",
        "devops-engineer"
      ]
    },
    {
      "id": "quality-security",
      "zh": "质量安全组",
      "en": "Quality & Security",
      "lead": "quality-security-lead",
      "mission": "守住正确、安全、性能与发布门禁：审查、重构、QA、自动化测试、安全审计、渗透、性能与可访问性。",
      "members": [
        "code-reviewer",
        "refactoring-engineer",
        "qa-engineer",
        "test-automation-engineer",
        "security-code-auditor",
        "vulnerability-pentester",
        "performance-engineer",
        "accessibility-reviewer",
        "release-gatekeeper"
      ]
    },
    {
      "id": "experience-delivery",
      "zh": "体验交付组",
      "en": "Experience & Delivery",
      "lead": "experience-delivery-lead",
      "mission": "把系统变成可交付、可传播的成品：UI 实现、动效、数据可视化、文档、上线、SEO、演示与客户成功。",
      "members": [
        "ui-implementation-engineer",
        "creative-motion-engineer",
        "data-viz-engineer",
        "technical-writer",
        "delivery-manager",
        "seo-growth-engineer",
        "presentation-designer",
        "customer-success-engineer"
      ]
    }
  ],
  "stages": [
    {
      "id": "intake",
      "zh": "受理分级",
      "owner": "codeforge-team-lead",
      "output": "任务卡：目标/范围/风险/验收口径"
    },
    {
      "id": "plan",
      "zh": "立项方案",
      "owner": "product-planning-lead",
      "output": "PRD/交互/视觉/里程碑与验收清单"
    },
    {
      "id": "build",
      "zh": "架构实现",
      "owner": "engineering-lead",
      "output": "可运行代码、迁移脚本、部署说明"
    },
    {
      "id": "gate",
      "zh": "质量门禁",
      "owner": "quality-security-lead",
      "output": "审查/测试/安全/性能报告与放行结论"
    },
    {
      "id": "deliver",
      "zh": "体验交付",
      "owner": "experience-delivery-lead",
      "output": "UI 实现、文档、上线与演示物料"
    },
    {
      "id": "review",
      "zh": "终验复盘",
      "owner": "codeforge-team-lead",
      "output": "交付包、证据链、遗留风险与复盘"
    }
  ],
  "policies": {
    "routing": "需求统一进主理人；主理人只派给四位组长；组长拆给组员；主理人只收组级交付包，不越级指挥；跨组依赖经主理人中转。",
    "handoff": [
      "task_id",
      "from",
      "to",
      "objective",
      "inputs",
      "constraints",
      "deliverable",
      "evidence",
      "acceptance",
      "risks",
      "deadline"
    ],
    "acceptance": [
      "可运行：有真实入口与启动命令",
      "可验证：测试/日志/截图/接口证据齐全",
      "安全：高危项清零或有书面豁免",
      "可维护：文档、回滚与负责人明确"
    ],
    "scaling": {
      "mode": "auto-intake",
      "rubric": "protocol/INTAKE.md",
      "dimensions": [
        "scope",
        "parallelism",
        "deliverable",
        "risk",
        "ambiguity",
        "verification"
      ],
      "maxScore": 18,
      "tiers": [
        {
          "id": "lite",
          "label": "精简档",
          "min": 0,
          "max": 5,
          "size": "1 lead + 1 group lead + 2-4 specialists"
        },
        {
          "id": "standard",
          "label": "标准档",
          "min": 6,
          "max": 11,
          "size": "1 lead + 2-3 group leads + 6-10 specialists"
        },
        {
          "id": "full",
          "label": "全量档",
          "min": 12,
          "max": 18,
          "size": "40"
        }
      ],
      "override": "用户点名档位 > 强制全量 > 显式范围 > 评分；边界分数向上取档",
      "announce": "开工前一行编队广播，不阻塞等待确认",
      "escalate": "计划阶段 >=3 组有交付物 / 任务卡 >=9 / 新增生产或安全要求 / 用户追加范围",
      "downgrade": "只在波次边界释放无任务角色，不打断运行中的工作"
    }
  },
